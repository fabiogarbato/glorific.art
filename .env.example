# ============================================================
# glorific.art — copie para .env e preencha. O .env NAO vai pro git.
# ============================================================

# ---------- Banco ----------
DB_NAME=glorific
DB_USER=glorific
DB_PASSWORD=troque-esta-senha

# ---------- Ambiente ----------
ASPNETCORE_ENVIRONMENT=Development
APP_PUBLIC_BASE_URL=http://localhost:5080
APP_LOJA_BASE_URL=http://localhost:5174

# ---------- JWT ----------
# Minimo 32 bytes. Gere com: openssl rand -base64 48
JWT_KEY=
JWT_ISSUER=glorific.art
JWT_AUDIENCE=glorific.art

# ---------- Login com Google ----------
# ONDE OBTER, passo a passo:
#   1. console.cloud.google.com > selecione (ou crie) o projeto da loja
#   2. APIs e servicos > Tela de permissao OAuth > tipo "Externo" > publique
#   3. APIs e servicos > Credenciais > Criar credenciais > ID do cliente OAuth
#      > Tipo de aplicativo: "Aplicativo da Web"
#   4. Origens JavaScript autorizadas: http://localhost:5174 (dev) e https://glorific.art (prod)
#      Nao ha URI de redirecionamento: o fluxo e o GSI (id_token no navegador), nao o code.
#   5. Copie o "ID do cliente" — ele termina em .apps.googleusercontent.com
#
# O MESMO valor vai no VITE_GOOGLE_CLIENT_ID do front (frontend/.env). Divergir entre os dois
# faz o botao aparecer e TODO login falhar: o back recusa a audience que o front pediu.
#
# NAO e segredo (o navegador o expoe), mas define a AUDIENCE que o back exige do id_token —
# e a unica coisa que impede um token emitido para outro aplicativo Google de entrar aqui.
#
# Vazio, o back sobe normalmente e POST /api/v1/auth/google responde 503 "o login com Google
# nao esta configurado nesta loja". Em producao/homologacao o boot aborta antes disso.
# Chega na API como Google__ClientId (ver docker-compose.yml).
GOOGLE_CLIENT_ID=

# Segredo do cliente OAuth. NAO e usado no fluxo atual (GSI so precisa validar o id_token);
# fica documentado para o dia em que houver troca de authorization code no servidor.
# GOOGLE_CLIENT_SECRET=

# ---------- InfinitePay ----------
# O handle e o @ da conta do lojista. E publico — nao e segredo, mas define quem recebe.
INFINITEPAY_HANDLE=
INFINITEPAY_BASE_URL=https://api.infinitepay.io

# ---------- Melhor Envio (microservico separado) ----------
# Entre containers use o DNS interno. NUNCA 127.0.0.1:5006 aqui.
ME_SERVICE_URL=http://melhorenvio_api:8080
ME_API_KEY=

# ---------- Frete: dados do remetente ----------
# Obrigatorios para cotar e comprar etiqueta. Sem CNPJ so existe envio nao-comercial,
# que varias transportadoras recusam.
FRETE_CEP_ORIGEM=
FRETE_REMETENTE_NOME=
FRETE_REMETENTE_DOCUMENTO=

# ---------- Criptografia de segredos em banco ----------
# AES-256-GCM. Gere com: openssl rand -base64 32
SECRETS_MASTER_KEY=

# ---------- Frontend (build args) ----------
VITE_API_URL=/api
